# 慧运营 — 上线环境变量模板
# 复制为项目根目录 .env 后填写
# 本机推荐：工具链 D:\devtools，数据 D:\outpost-data（见 docs/LOCAL_SETUP.md）

PORT=8787
NODE_ENV=development

# 数据驱动：json（当前默认）| postgres（仓储未实现前勿用）
DATA_DRIVER=json
DATABASE_URL=postgres://outpost:outpost@127.0.0.1:5432/outpost

# JSON 状态目录（绝对路径）。多店时由 shops bootstrap 覆盖：
#   D:\outpost-data\shops\{projectCode}\json
OUTPOST_DATA_DIR=D:\outpost-data\shops\PRJ396770\json
OUTPOST_ROOT=D:\outpost-data

# 当前店 Partner API 凭证（另一店：D:\PRJ482387\noon_credentials_sensitive.json）
OUTPOST_NOON_CREDENTIALS_FILE=D:\PRJ396770\noon_credentials_sensitive.json

# NOON 接入模式：
# - live    Partner API（Impex/Content），多店推荐，无需浏览器登录
# - portal  网页导出导入 / Cookie 会话拉取
# - mock    本地模拟数据（先验链路）
# - inherit 使用界面里保存的配置
NOON_MODE=live
NOON_ENABLED=true
NOON_BASE_URL=https://noon-api-gateway.noon.partners
NOON_PARTNER_ID=PRJ396770
NOON_API_KEY=
NOON_API_SECRET=
NOON_WEBHOOK_SECRET=
NOON_COUNTRY_CODE=sa
NOON_POLL_INTERVAL_MS=120000

# 飞书「常用四表」桥接（P0：只拉 raw，不入库）
# 详见 docs/FEISHU_BRIDGE.md
OUTPOST_FEISHU_APP_ID=
OUTPOST_FEISHU_APP_SECRET=
# 复制 apps/api/config/feishu.docs.example.json → 本路径并填入 spreadsheetToken
OUTPOST_FEISHU_DOCS_FILE=D:\outpost-data\feishu.docs.json
OUTPOST_FEISHU_RAW_DIR=D:\outpost-data\feishu-raw
OUTPOST_FEISHU_NORMALIZED_DIR=D:\outpost-data\feishu-normalized

# 汇总同步（Noon + 飞书同一条链）：定时 + 手动 POST /api/sync/assembly-sync
OUTPOST_ASSEMBLY_SYNC_ENABLED=true
# 默认 6 小时
OUTPOST_ASSEMBLY_SYNC_EVERY_MS=21600000
# 启动后是否自动跑一次（默认否，避免与手动撞 Impex）
OUTPOST_ASSEMBLY_SYNC_ON_BOOT=false

# —— 市场&竞品情报（Noon 沙特，独立于店铺 json）——
# 数据根：%OUTPOST_ROOT%\market-imports\noon\sa\
# API：/api/market-intel/*
# 侧栏：市场情报
# 正式默认：影刀 inbox → 浏览器插件（已禁用 noon.com HTTP 直连，会 403）
# 开发联调可临时：MARKET_INTEL_ALLOW_MOCK=true
# 插件目录：apps/market-intel-extension

# DeepSeek：仅用于 pending 品牌「沙特/MENA 知名度」审核（搜证走代码，无证据不调模型）
# DEEPSEEK_API_KEY=
# 也可把 key 放在仓库根 DS-key.txt（已 gitignore）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# BRAND_INTEL_AUTO_APPLY=true
# BRAND_INTEL_MIN_CONFIDENCE=0.75
# BRAND_INTEL_CACHE_DAYS=30
