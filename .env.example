# 慧运营 — 上线环境变量模板
# 复制为项目根目录 .env 后填写
# 本机推荐：工具链 D:\devtools，数据 D:\outpost-data（见 docs/LOCAL_SETUP.md）

PORT=8787
NODE_ENV=development

# 数据驱动：json（当前默认）| postgres（仓储未实现前勿用）
DATA_DRIVER=json
DATABASE_URL=postgres://outpost:outpost@127.0.0.1:5432/outpost

# JSON 状态目录（绝对路径）。多店时由 shops bootstrap 覆盖：
#   D:\outpost-data\shops\{projectCode}\json
OUTPOST_DATA_DIR=D:\outpost-data\shops\PRJ396770\json
OUTPOST_ROOT=D:\outpost-data

# 人工操作审计日志（谁/何时/做了什么）。默认 %OUTPOST_ROOT%\audit
#   events\yyyy\mm\yyyy-mm-dd.jsonl  — 原始事件
#   daily\yyyy\mm\yyyy-mm-dd.json    — 按日汇总
# OUTPOST_AUDIT_DIR=D:\outpost-data\audit

# —— 多租户账号（浏览共享 / 操作按用户隔离）——
# 首次启动若无用户，自动创建超管 admin。
# 若设置本变量则用其作为初始密码；否则写入 %OUTPOST_ROOT%\admin-bootstrap.txt
# OUTPOST_ADMIN_PASSWORD=
# 共享：店铺 state.json（catalog/销售/库存等）、市场情报爬取结果、飞书 raw/normalized
# 隔离：users/{userId}/ 下的 listing-drafts、favorites、market-intel/watchlist、prefs
# 登录：POST /api/auth/login（Cookie 会话）；超管可 POST /api/auth/users 建号

# 当前店 Partner API 凭证（另两店：D:\PRJ482387\ 与 D:\PRJ488078\noon_credentials_sensitive.json）
OUTPOST_NOON_CREDENTIALS_FILE=D:\PRJ396770\noon_credentials_sensitive.json

# NOON 接入模式：
# - live    Partner API（Impex/Content），多店推荐，无需浏览器登录
# - portal  网页导出导入 / Cookie 会话拉取
# - mock    本地模拟数据（先验链路）
# - inherit 使用界面里保存的配置
NOON_MODE=live
NOON_ENABLED=true
NOON_BASE_URL=https://noon-api-gateway.noon.partners
NOON_PARTNER_ID=PRJ396770
NOON_API_KEY=
NOON_API_SECRET=
NOON_WEBHOOK_SECRET=
NOON_COUNTRY_CODE=sa
NOON_POLL_INTERVAL_MS=120000
# Catalog 同时拉 live + notlive（ops_daily / Prep 对账需要；默认仅 live 省配额）
OUTPOST_NOON_CATALOG_STATUSES=live,notlive

# 飞书「常用四表」桥接（P0：只拉 raw，不入库）
# 详见 docs/FEISHU_BRIDGE.md
OUTPOST_FEISHU_APP_ID=
OUTPOST_FEISHU_APP_SECRET=
# 复制 apps/api/config/feishu.docs.example.json → 本路径并填入 spreadsheetToken
OUTPOST_FEISHU_DOCS_FILE=D:\outpost-data\feishu.docs.json
OUTPOST_FEISHU_RAW_DIR=D:\outpost-data\feishu-raw
OUTPOST_FEISHU_NORMALIZED_DIR=D:\outpost-data\feishu-normalized

# 1688 买家订单物流（采购管理批量查询）
# 登录态：持久化目录 browser-profile + storage-state.json；采购页点「获取 1688 登录态」
# OUTPOST_1688_DIR=D:\outpost-data\alibaba-1688
# OUTPOST_1688_STORAGE_STATE=D:\outpost-data\alibaba-1688\storage-state.json
# OUTPOST_1688_PROFILE_DIR=D:\outpost-data\alibaba-1688\browser-profile
# 可选：用本机 Chrome 通道（更像真人浏览） OUTPOST_1688_BROWSER_CHANNEL=chrome

# 汇总同步（Noon + 飞书同一条链）：定时 + 手动 POST /api/sync/assembly-sync
OUTPOST_ASSEMBLY_SYNC_ENABLED=true
# 默认 6 小时
OUTPOST_ASSEMBLY_SYNC_EVERY_MS=21600000
# 启动后是否自动跑一次（默认否，避免与手动撞 Impex）
OUTPOST_ASSEMBLY_SYNC_ON_BOOT=false
# Playwright 登录态定时续期已下线（不再弹 Chrome）；仅手工 keepalive 时忽略此项
OUTPOST_PW_KEEPALIVE_ENABLED=false
# —— Noon 伙伴后台邮箱 OTP 无人值守（统一登录 ads/sales/keepalive login）——
# 网易须先开 IMAP，用「客户端授权码」填 PASS（不要用网页登录密码；勿提交 git）
# OUTPOST_NOON_OTP_AUTO=1
# OUTPOST_NOON_LOGIN_EMAIL=17727538283@163.com
# OUTPOST_NOON_OTP_IMAP_HOST=imap.163.com
# OUTPOST_NOON_OTP_IMAP_PORT=993
# OUTPOST_NOON_OTP_IMAP_USER=17727538283@163.com
# OUTPOST_NOON_OTP_IMAP_PASS=
# 可选：若登录还有密码步
# OUTPOST_NOON_LOGIN_PASSWORD=
# IMAP 轮询秒数（默认 180）
# OUTPOST_NOON_OTP_IMAP_WAIT_SEC=180
# —— Noon 伙伴后台邮箱 OTP（无人值守登录；授权码只放本机 .env，勿提交）——
# 网易邮箱须网页开启 IMAP，并生成「客户端授权码」（不是网页登录密码）
# OUTPOST_NOON_OTP_AUTO=1
# OUTPOST_NOON_LOGIN_EMAIL=17727538283@163.com
# OUTPOST_NOON_OTP_IMAP_HOST=imap.163.com
# OUTPOST_NOON_OTP_IMAP_USER=17727538283@163.com
# OUTPOST_NOON_OTP_IMAP_PASS=
# 可选：若登录还有密码步
# OUTPOST_NOON_LOGIN_PASSWORD=
# OUTPOST_NOON_OTP_POLL_SEC=180
# OUTPOST_NOON_OTP_SENDER_HINT=noon

# 启动后检查销售/订单/广告等缺口并补洞（会触发 Playwright 广告导出弹 Chrome；本地建议 false）
OUTPOST_DATA_BACKFILL_ON_BOOT=false
OUTPOST_DATA_BACKFILL_BOOT_DELAY_MS=45000
# 数据对齐总览只盯这些店（默认前两家老店）；销量/订单/广告下午几点起要求覆盖昨天
# OUTPOST_HEALTH_GATE_SHOP_IDS=PRJ396770,PRJ482387
# OUTPOST_LAG_SYNC_HOUR_SHANGHAI=14

# —— 晨报推送（墙钟 Asia/Shanghai；店内 / 情报分开发飞书卡片）——
# 店内：02:00 汇总→门禁→模型→推送（广告影刀建议 01:00，留约 1h）
OUTPOST_STORE_DIGEST_ENABLED=true
OUTPOST_STORE_DIGEST_AT=02:00
# 市场情报：默认关，影刀挂上定时后在「定时任务」页启用或改 true
OUTPOST_MI_DIGEST_ENABLED=false
OUTPOST_MI_DIGEST_AT=03:30
# 门禁失败重试（定时触发；手动立即执行默认不重试）
OUTPOST_DIGEST_GATE_RETRY_MAX=3
OUTPOST_DIGEST_GATE_RETRY_MS=1200000
# 门禁熔断 / 推送失败：只记日志，不发飞书告警卡
# OUTPOST_MI_DIGEST_NOTIFY_EMPTY=false
# OUTPOST_MORNING_DIGEST_DIR=D:\outpost-data\morning-digest

# —— 市场&竞品情报（Noon 沙特，独立于店铺 json）——
# 数据根：%OUTPOST_ROOT%\market-imports\noon\sa\
# API：/api/market-intel/*
# 侧栏：市场情报
# 正式默认：影刀 inbox → 浏览器插件（已禁用 noon.com HTTP 直连，会 403）
# 开发联调可临时：MARKET_INTEL_ALLOW_MOCK=true
# 插件目录：apps/market-intel-extension

# DeepSeek：品牌审核 + 晨报汇总 + Agent Hub 中枢编排（搜证走代码，无证据不调模型）
# DEEPSEEK_API_KEY=
# 也可把 key 放在仓库根 DS-key.txt（已 gitignore）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# Agent Hub 轻量编排（POST /api/agent-hub/ask）：同进程 loopback，无独立注册中心/心跳
# AGENT_HUB_MAX_ROUNDS=3
# AGENT_HUB_MAX_TOOLS_PER_ROUND=3
# AGENT_HUB_TOOL_TIMEOUT_MS=12000
# AGENT_HUB_LLM_TIMEOUT_MS=45000
# AGENT_HUB_MAX_RESULT_CHARS=6000
# AGENT_HUB_LOOPBACK_BASE=http://127.0.0.1:8787
# BRAND_INTEL_AUTO_APPLY=true
# BRAND_INTEL_MIN_CONFIDENCE=0.75
# BRAND_INTEL_CACHE_DAYS=30
# Listing AI：仅看本品图时用 Vision；对标/写稿走文本 LLM（勿混用）
# LISTING_VISION_MODEL=deepseek-v4-flash-vision-exp
# LISTING_TEXT_MODEL=deepseek-flash
# Listing 宣传图（默认 folder：拼 prompt+refs 投递 inbox，轮询 out/ 回显；员工无需登录）
# LISTING_PROMO_DRIVER=folder
# LISTING_PROMO_INBOX=D:\Outpost_ERP\.tmp_listing_promo_inbox
# LISTING_PROMO_POLL_MS=4000
# LISTING_PROMO_POLL_TIMEOUT_MS=2700000
# 仅当 DRIVER=sdk 才需要（不推荐全公司用）:
# CURSOR_API_KEY=
# LISTING_PROMO_MODEL=composer-2.5
