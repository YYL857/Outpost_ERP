{
  "manifest_version": 3,
  "name": "Outpost Listing Competitor Capture",
  "version": "0.2.0",
  "description": "Capture a Noon SA PDP into your own Outpost Listing competitor inbox (per-user).",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.noon.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Capture PDP → Listing",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.noon.com/saudi-en/*",
        "https://www.noon.com/saudi-ar/*",
        "https://www.noon.com/*/*/N*/p*",
        "https://www.noon.com/*/*/N*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
