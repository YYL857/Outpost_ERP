{
  "baseUrl": "https://www.noon.partners/",
  "headless": false,
  "timeoutMs": 180000,
  "reports": [
    {
      "id": "catalog_live",
      "label": "在线商品",
      "domainHint": "catalog",
      "url": "https://www.noon.partners/en-ae/catalog-exports",
      "actions": [
        { "type": "goto", "url": "https://www.noon.partners/en-ae/catalog-exports" },
        { "type": "click", "selector": "text=Online products", "optional": true },
        { "type": "click", "selector": "text=Export", "optional": true },
        { "type": "waitDownload", "filenameIncludes": "live", "optional": true }
      ]
    },
    {
