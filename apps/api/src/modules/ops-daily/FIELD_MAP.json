{
  "version": "1.0-phase4-closed",
  "status": "Prep→ops-daily Phase1–4 旁路迁移已收口（2026-10-09）；见 FLOW PHASE4_GOLDEN_DIFF_REPORT.md；可与 Prep 并行观察",
  "locked": "D:/Desktop/FLOW/pipelines/noon_ops_daily/contracts/OUTPOST_LOCK.md",
  "timezone": "Asia/Shanghai",
  "grain": "one row per Noon SKU (catalog.noonSku); live preferred over notlive",
  "output": "D:/outpost-data/shops/{shopId}/ops_daily/运营面板_今天_{asOf}.csv",
  "phase4_outputs": {
    "weekly": "ops_daily/landed_产品表每周信息.csv — psku,自己出库费,佣金比例,平台实际出库费",
    "landed": "ops_daily/landed_到仓成本.csv — PSKU,运输方式,最终单件SKU成本",
    "self_outbound": "skuDims+在线价 → fbn_fee_tiers 尺寸档/称重升级/ASP≤25",
    "commission": "feeSnapshots.commissionRate / outboundFee（v1 聚合；非 TV 行级最新单）",
    "landed_cost": "packing 箱表+明细重量占比分摊国内/跨境 + skuLocalCosts.purchaseCost",
    "feishu_writeback": "settings.feishu_product_writeback 默认 false；v1 不写飞书"
  },
  "columns": [
    { "panel": "日期", "phase": 1, "source": "asOf Asia/Shanghai" },
    { "panel": "PSKU", "phase": 1, "source": "catalog.partnerSku" },
    { "panel": "SKU", "phase": 1, "source": "catalog.noonSku" },
    { "panel": "产品名称", "phase": 1, "source": "catalog.title" },
    { "panel": "入仓天数", "phase": 3, "source": "FBN detailed FIFO 首次 inbound→asOf+1；无流水=入仓天数缺失" },
    { "panel": "当前在线状态", "phase": 1, "source": "catalog.isActive → 在线/不在线" },
    { "panel": "在线价", "phase": 1, "source": "activePrice ?? price" },
    { "panel": "30销量", "phase": 1, "source": "sales_export row-count; exclude invalid statuses; key=SKU" },
    { "panel": "30访客", "phase": 2, "source": "productviews Your_Visitors（优先 portal/cache，否则 FLOW 浏览转化报表）" },
    { "panel": "30转化率", "phase": 2, "source": "ΣShipped_Units/Σ访客" },
    { "panel": "近30天退货率", "phase": 1, "source": "Returned/all rows in 30d window" },
    { "panel": "链接状态", "phase": "manual", "source": null },
    { "panel": "产品主等级", "phase": "manual", "source": null },
    { "panel": "操作备注", "phase": "manual", "source": null },
    { "panel": "问题标签汇总", "phase": "manual", "source": null },
    { "panel": "广告亏损判断标签", "phase": 2, "source": "7/15/30 窗标签近似汇总" },
    { "panel": "清货优先级", "phase": "manual", "source": null },
    { "panel": "库龄风险等级", "phase": 3, "source": "五桶：正常/轻度老化/中度/重度/超长期；无流水=入仓天数缺失" },
    { "panel": "365天以上", "phase": 3, "source": "FBN detailed FIFO leftover" },
    { "panel": "271-365天", "phase": 3, "source": "同上" },
    { "panel": "181-270天", "phase": 3, "source": "同上" },
    { "panel": "91-180天", "phase": 3, "source": "同上" },
    { "panel": "0-90天", "phase": 3, "source": "同上" },
    { "panel": "FBN", "phase": 1, "source": "fbn_vs_supermall_{asOf}.csv fbn_qty；缺则 state.stock+warehouse_map" },
    { "panel": "supermall", "phase": 1, "source": "fbn_vs_supermall supermall_qty / state.stock" },
    { "panel": "空运在途", "phase": 3, "source": "装箱明细在途 air；缺则 feishuOpsSnapshots" },
    { "panel": "海运在途", "phase": 3, "source": "装箱明细在途 sea；缺则 feishuOpsSnapshots" },
    { "panel": "已采购数量", "phase": 3, "source": "purchaseLines 未关闭行 Σqty" },
    { "panel": "空运计划补货", "phase": "manual", "source": null },
    { "panel": "海运计划补货", "phase": "manual", "source": null },
    { "panel": "后台库存比例", "phase": "manual", "source": null },
    { "panel": "空运补货比例", "phase": "manual", "source": null },
    { "panel": "总补货比例", "phase": "manual", "source": null },
    { "panel": "7天广告盈亏标签", "phase": 2, "source": "portal ads_sku 单日 CSV Σ；标签：未投放/无法判断/有花费无订单/广告不亏(ROAS≥1)/广告亏损" },
    { "panel": "7广告花费", "phase": 2, "source": "Σspend 7d by Noon SKU" },
    { "panel": "7广告订单", "phase": 2, "source": "Σorders 7d" },
    { "panel": "7广告销售额", "phase": 2, "source": "Σrevenue 7d" },
    { "panel": "7ROAS", "phase": 2, "source": "revenue/spend" },
    { "panel": "15天广告盈亏标签", "phase": 2, "source": "同上 15d" },
    { "panel": "15广告花费", "phase": 2, "source": "同上 15d" },
    { "panel": "15广告订单", "phase": 2, "source": "同上 15d" },
    { "panel": "15广告销售额", "phase": 2, "source": "同上 15d" },
    { "panel": "15ROAS", "phase": 2, "source": "同上 15d" },
    { "panel": "30天广告盈亏标签", "phase": 2, "source": "同上 30d；portal 单日覆盖不全时偏低（见 meta.adsDaysMissing）" },
    { "panel": "30广告花费", "phase": 2, "source": "同上 30d" },
    { "panel": "30广告订单", "phase": 2, "source": "同上 30d" },
    { "panel": "30广告销售额", "phase": 2, "source": "同上 30d" },
    { "panel": "30ROAS", "phase": 2, "source": "同上 30d" }
  ],
  "margin_equiv": {
    "海运毛利率": "assemble.margin when !preferAir（面板等价，非 Phase4 CSV 列）",
    "空运毛利率": "assemble.margin when preferAir",
    "单品毛利率": "assemble.margin (current prefer mode)",
    "preferAir": "skuLocalCosts.preferAir",
    "cargoType": "skuLocalCosts.cargoType"
  },
  "configs": {
    "warehouse_map": "apps/api/config/ops-daily/warehouse_map.json",
    "fbn_fee_tiers": "apps/api/config/ops-daily/fbn_fee_tiers.json",
    "settings": "apps/api/config/ops-daily/settings.json"
  }
}
