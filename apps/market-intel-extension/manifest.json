{
  "manifest_version": 3,
  "name": "Outpost Noon SA Capture",
  "version": "0.2.1",
  "description": "Noon SA capture: category ingest + PDP price monitor for Outpost market-intel.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.noon.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Capture page → Outpost",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.noon.com/saudi-en/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
