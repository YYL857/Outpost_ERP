{
  "manifest_version": 3,
  "name": "Outpost Noon SA Capture",
  "version": "0.1.0",
  "description": "Capture Noon Saudi listing JSON and POST to local Outpost market-intel ingest.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.noon.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "action": {
    "default_title": "Capture page → Outpost",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.noon.com/saudi-en/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
