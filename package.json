{
  "name": "outpost-erp",
  "private": true,
  "version": "0.1.0",
  "description": "前哨 Outpost — 跨境电商 ERP",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @outpost/web --filter @outpost/api run dev",
